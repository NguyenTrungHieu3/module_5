# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/

# Package manager locks (too large, not useful for AI)
package-lock.json
yarn.lock
pnpm-lock.yaml

# IDE & OS files
.idea/
.vscode/settings.json
*.swp
*.swo
Thumbs.db
.DS_Store

# Environment secrets
.env
.env.local
.env.production

# Test coverage & reports
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*

# Python (if applicable)
__pycache__/
*.pyc
.venv/
venv/

# Large binary files
*.zip
*.tar.gz
*.mp4
*.mov
*.psd
*.ai

# Extra skills directory (not used by agent — agent reads .agents/skills/ only)
skills/
skills-lock.json

# Gemini internal data
.gemini/

# Java / Spring Boot (if applicable)
target/
*.jar
*.class
.gradle/
*.war

# Docker
docker-compose.override.yml
Dockerfile.dev

# Database files
*.sqlite3
*.db

# Python extras
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Media assets (binary — AI không cần đọc)
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.woff
*.woff2
*.ttf
*.eot
